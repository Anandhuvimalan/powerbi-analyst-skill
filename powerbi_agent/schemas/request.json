{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project", "sources", "business_goal"],
  "additionalProperties": false,
  "properties": {
    "project": {"type": "string", "pattern": "\\.pbip$"},
    "output": {"type": "string", "pattern": "\\.pbip$"},
    "sources": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string"}, {"type": "object", "properties": {"path": {"type": "string"}, "kind": {"enum": ["sqlserver", "sqlite"]}, "name": {"type": "string"}, "sheet": {"type": "string"}, "table": {"type": "string"}, "schema": {"type": "string"}, "server": {"type": "string"}, "database": {"type": "string"}, "connection_env": {"type": "string"}, "delimiter": {"type": "string", "minLength": 1, "maxLength": 1}}, "additionalProperties": false}]}},
    "business_goal": {"type": "string", "minLength": 1},
    "agent_mode": {"type": "boolean"},
    "analysis_brief": {"type": ["string", "object"]},
    "brand": {"type": "object", "properties": {"company": {"type": ["string", "null"]}, "primary_color": {"type": ["string", "null"], "pattern": "^#[a-fA-F0-9]{6}$"}}, "additionalProperties": false},
    "max_rows": {"type": "integer", "minimum": 1, "maximum": 5000000},
    "model_plan": {"type": ["string", "object"]},
    "report_plan": {"type": ["string", "object"]},
    "reasoning": {"type": "object", "required": ["command"], "properties": {"command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "knowledge_root": {"type": "string"}}, "additionalProperties": false},
    "modeling": {"type": "object", "properties": {"mode": {"enum": ["file", "mcp"]}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "auto_open_powerbi": {"type": "boolean"},
    "runtime": {"type": "object", "properties": {"desktop": {"type": "boolean"}, "native_refresh": {"type": "boolean"}, "connection_env": {"type": "string"}, "refresh": {"type": "boolean"}}, "additionalProperties": false},
    "visual_qa": {"type": "boolean"},
    "remote_schema": {"type": "boolean"},
    "desktop": {"type": "object", "properties": {"pid": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "qa": {"type": "object", "properties": {"reviewer_command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "max_iterations": {"type": "integer", "minimum": 1, "maximum": 10}, "threshold": {"type": "number", "minimum": 0, "maximum": 100}}, "additionalProperties": false}
  }
}
