{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["width", "height", "theme", "pages"], "additionalProperties": false,
  "properties": {
    "width": {"type": "number", "minimum": 320, "maximum": 7680}, "height": {"type": "number", "minimum": 240, "maximum": 4320},
    "design_rationale": {"type": "string"}, "theme": {"type": "object", "required": ["palette", "definition"], "properties": {"palette": {"type": "object"}, "definition": {"type": "object"}}},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "title", "visuals"], "properties": {
      "name": {"type": "string"}, "title": {"type": "string"}, "subtitle": {"type": "string"}, "hidden": {"type": "boolean"}, "tooltip": {"type": "boolean"},
      "drillthrough": {"$ref": "#/$defs/binding"}, "filters": {"type": "array"}, "interactions": {"type": "array"},
      "visuals": {"type": "array", "items": {"type": "object", "required": ["type", "title", "question", "position"], "properties": {
        "type": {"type": "string"}, "title": {"type": "string"}, "question": {"type": "string", "minLength": 1},
        "position": {"type": "object", "required": ["x", "y", "width", "height"], "additionalProperties": false, "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
        "roles": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/binding"}}},
        "objects": {"type": "object"}, "container_objects": {"type": "object"}, "filters": {"type": "array"}, "sort": {"$ref": "#/$defs/binding"}, "descending": {"type": "boolean"}
      }}}
    }}}
  },
  "$defs": {"binding": {"type": "object", "required": ["table", "name"], "properties": {"table": {"type": "string"}, "name": {"type": "string"}, "kind": {"enum": ["Column", "Measure"]}}, "additionalProperties": false}}
}
